import os
os.chdir(os.path.dirname(os.path.abspath(__file__)))

print(f"Current working directory: {os.getcwd()}")

DIRECTORY = '../../../aea_data/econlitData/'
OUTPUT_DIRECTORY = "../../datasets/econlit/"

FILE = '../../../aea_data/econlitData/econlit_data_1969.txt'


# %%
# Load the data

data = pd.read_csv(FILE, sep = "\t", dtype= pd.StringDtype())

names = ['Accession Number', 
         'ISSN', 
         'Journal Title', 
         "Volume/Issue", 
         "Cover Date", 
         "Publication Year", 
         "Author", 
         "Title", 
         "JEL Codes (1991)", 
         "JEL Codes (1969)", 
         "Abstract", 
         "Affiliation"]

data.columns = names
print(data.head())

data = pd.DataFrame(columns = names)



# %%

for filename in os.listdir(DIRECTORY):
    file_path = os.path.join(DIRECTORY, filename)
    print(f"Processing file: {filename}")
    new_data = pd.read_csv(file_path, sep="\t", dtype=pd.StringDtype())
    new_data.columns = names
    print(new_data.describe())
    data = pd.concat([data,new_data])

data.describe()

